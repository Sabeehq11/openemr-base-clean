vars {
  agent: http://127.0.0.1:8401
  openemr: https://localhost:9300
  user_uuid: {{process.env.COPILOT_USER_UUID}}
  patient_uuid: {{process.env.COPILOT_PATIENT_UUID}}
  other_patient_uuid: {{process.env.COPILOT_OTHER_PATIENT}}
  signing_secret: {{process.env.COPILOT_SIGNING_SECRET}}
  user_token: {{process.env.COPILOT_USER_TOKEN}}
  dashboard_token: {{process.env.COPILOT_DASHBOARD_TOKEN}}
}
