meta {
  name: Chat without a signature (must be refused)
  type: http
  seq: 3
}

post {
  url: {{agent}}/v1/chat
  body: json
  auth: none
}

body:json {
  {
    "patient_uuid": "11111111-2222-3333-4444-555555555555",
    "question": "brief"
  }
}

assert {
  res.status: eq 401
}

docs {
  The browser never calls this directly. The OpenEMR module signs it (agent/app/signing.py). Unsigned calls get a generic 401.
}
