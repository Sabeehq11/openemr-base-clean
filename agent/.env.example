# Copy to agent/.env (git-ignored). Never commit real values. Synthetic data only.
# OpenEMR base URL as reachable FROM the agent process.
OPENEMR_BASE_URL=https://localhost:9300
# Local dev stack uses a self-signed certificate. Keep true everywhere else.
OPENEMR_VERIFY_TLS=false
# LLM: stub (deterministic, no network) or openrouter.
LLM_PROVIDER=stub
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Shared secret with oe-module-copilot (request integrity only; never grants access).
MODULE_SIGNING_SECRET=change-me-generate-with-openssl-rand-hex-32
# Key for the audit hash chain.
AUDIT_HMAC_KEY=change-me-generate-with-openssl-rand-hex-32
DATA_DIR=./data

# Password for /dashboard (HTTP Basic, any user name). Empty disables the dashboard.
DASHBOARD_TOKEN=change-me-generate-with-openssl-rand-hex-16
# Password given to the seeded fixture users (copilot_doc_a, copilot_doc_b, copilot_nurse, copilot_front). >= 12 chars.
COPILOT_FIXTURE_PASSWORD=change-me-12-chars-minimum
# OAuth client the module registered for the agent (see agent/AUTHZ_PROOF.md and scripts/copilot/copilot_issue_probe.php).
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Optional cap on chats in progress (503 + Retry-After above it). 0 = off (default).
# MAX_INFLIGHT_CHATS=0

# --- Week 2 (inert unless W2_ENABLED=true). Synthetic documents only. ---
W2_ENABLED=false
# Document extraction model (OpenRouter, multimodal) and hosted embedding model for guideline retrieval.
W2_VLM_MODEL=anthropic/claude-sonnet-4.5
W2_EMBED_MODEL=openai/text-embedding-3-small
# Guideline reranker: Cohere Rerank v3.5 through OpenRouter /rerank, using OPENROUTER_API_KEY above.
# No OpenRouter key = offline lexical rerank (rerank_skipped is flagged only for outages).
W2_RERANK_MODEL=cohere/rerank-v3.5
# true = canned extraction output, no network. For CI and offline demos only; never with real documents.
W2_USE_STUB_VLM=false
W2_MAX_UPLOAD_BYTES=8388608
W2_MAX_PAGES=5
